#!/usr/bin/env python3
"""Run Vantage straight from the checkout:  ./vantage scan 10.0.0.5 --authorized

The package lives in src/ so that this launcher can be called `vantage` — a file
and a directory of the same name cannot sit in the same folder.
"""

import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

try:
    from vantage.cli import main
except ModuleNotFoundError as exc:  # pragma: no cover - environment problem
    if "rich" in str(exc):
        sys.exit(
            "Vantage needs rich for its terminal output:\n"
            "    pip install rich\n"
            "or install the package:  pip install -e '.[cli,ui]'"
        )
    raise

if __name__ == "__main__":
    raise SystemExit(main())
